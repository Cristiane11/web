rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isManager() {
      return request.auth != null && (
        (request.auth.token.email_verified == true && request.auth.token.email in ['cristipiane@gmail.com']) ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'manager'
      );
    }
    // Blog images: public read, only the manager can upload (images up to 5 MB).
    match /posts/{allPaths=**} {
      allow read: if true;
      allow write: if isManager() && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow delete: if isManager();
    }
  }
}
