# ---------- Frontend (exposed to the browser, prefix VITE_) ----------
# Firebase console > Project settings > General > Your apps > Web app config
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=fir-firstproject-b14ad.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=fir-firstproject-b14ad
VITE_FIREBASE_STORAGE_BUCKET=fir-firstproject-b14ad.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# Email(s) allowed to become "manager" (comma separated). Must match firestore.rules.
VITE_MANAGER_EMAIL=cristipiane@gmail.com
VITE_BOOKING_URL=https://calendly.com/cristiane-abreu/seo-project-meeting
# Public URL of the site (used for canonical URLs, Open Graph, share links)
VITE_SITE_URL=https://profile.professionalwebsite.co
# Optional: Sentry DSN to capture production errors
VITE_SENTRY_DSN=
# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# ---------- Server only (Vercel serverless functions, NEVER prefix with VITE_) ----------
MANAGER_EMAIL=cristipiane@gmail.com
NOTIFY_EMAIL=cristipiane@gmail.com
SITE_URL=https://profile.professionalwebsite.co

# Firebase Admin SDK - Firebase console > Project settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=fir-firstproject-b14ad
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@fir-firstproject-b14ad.iam.gserviceaccount.com
# Paste the key with literal \n for line breaks
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Email notifications: Resend (preferred) ...
RESEND_API_KEY=
RESEND_FROM="Website Bookings <onboarding@resend.dev>"
# ... or SMTP fallback (e.g. Gmail with an App Password)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google Sheets export (service account with Sheets API enabled; share the sheet with its email)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Protects /api/publish-scheduled (Vercel Cron sends it automatically as Bearer token)
CRON_SECRET=generate-a-long-random-string

# Instagram feed on the Home page (/api/instagram). Long-lived token from an Instagram Professional account; expires ~60 days.
INSTAGRAM_ACCESS_TOKEN=
# Optional: Instagram user ID (defaults to "me")
INSTAGRAM_USER_ID=
# Optional default handle for the Instagram link (admin setting overrides it)
VITE_INSTAGRAM_HANDLE=your_instagram_handle
